# Domínio público usado em canonical, sitemap e metadados.
NEXT_PUBLIC_SITE_URL=https://grove-lake.vercel.app
# ID do fluxo Web do Google Analytics 4. Não é uma credencial secreta.
NEXT_PUBLIC_GA_ID=
# Token opcional de verificação da propriedade no Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Token opcional da tag HTML de verificação do Yandex Webmaster.
YANDEX_SITE_VERIFICATION=
